# RBAC key store. Generate strong random values for anything public:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=replace-me-admin
AGENT_API_KEY=replace-me-agent
ANALYST_API_KEY=replace-me-analyst

# Key injected into the dashboard page. Keep this analyst-scoped: whatever goes
# here is visible to anyone who opens the page source. Defaults to ANALYST_API_KEY.
# DASHBOARD_API_KEY=replace-me-analyst

# SQLite location. Point at a mounted disk to survive restarts.
DATABASE_URL=sqlite:///./logs.db

# Populate a first-run database with sample traffic so the dashboard is not empty.
SEED_DEMO_DATA=true

# Collector agent (agent.py) only
SIEM_ENDPOINT=http://127.0.0.1:8000/api/v1/ingest
SIEM_API_KEY=replace-me-agent
SEND_INTERVAL_SECONDS=3
